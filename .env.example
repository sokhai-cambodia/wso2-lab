# Root .env — values passed to the backend Docker container.
# Copy to .env and adjust. Every value here matches the docker-compose.yml
# default (which in turn matches the seeded lab), so a fresh clone works
# with no .env at all — only create one to override something.

# WSO2 IS: OAuth app registered at https://localhost:9444/console
# (defaults in docker-compose.yml match the Service Provider baked into the seed dumps)
WSO2_IS_CLIENT_ID=
WSO2_IS_CLIENT_SECRET=
WSO2_IS_PUBLIC_URL=https://localhost:9444

# Federated connection names in IS (Console → Connections — must match exactly)
GITHUB_IDP_NAME=GitHub
MICROSOFT_IDP_NAME=Microsoft

# OAuth callback + frontend URLs (browser-accessible, behind nginx)
AUTH_CALLBACK_URL=https://portal.local.test/callback
FRONTEND_URL=https://portal.local.test

# PostgreSQL — defaults match docker-compose.yml; override if needed
POSTGRES_PORT=5433
POSTGRES_USER=wso2
POSTGRES_PASSWORD=wso2123
POSTGRES_DB=wso2db
