# Root .env — every variable docker-compose.yml reads, with its default.
# Copy to .env and adjust. All defaults match the seeded lab, so a fresh
# clone works with no .env at all — only create one to override something.

# ── WSO2 IS ─────────────────────────────────────────────────────────────────
# OAuth app registered at https://localhost:9444/console
# (defaults in docker-compose.yml match the Service Provider baked into the seed dumps)
WSO2_IS_CLIENT_ID=
WSO2_IS_CLIENT_SECRET=
# Docker-internal URL (compose service name) — rarely needs changing
WSO2_IS_URL=https://wso2is:9444
# Browser-accessible URL (used in the authorize redirect)
WSO2_IS_PUBLIC_URL=https://localhost:9444

# ── WSO2 APIM ───────────────────────────────────────────────────────────────
# Docker-internal URL — backend uses it only to load JWKS
WSO2_APIM_URL=https://wso2apim:9443

# ── Federated login ─────────────────────────────────────────────────────────
# Connection names in IS (Console → Connections — must match exactly)
GITHUB_IDP_NAME=github
MICROSOFT_IDP_NAME=Microsoft

# ── URLs (browser-accessible, behind nginx) ─────────────────────────────────
AUTH_CALLBACK_URL=https://portal.local.test/callback
FRONTEND_URL=https://portal.local.test
# BUILD-time value baked into the frontend bundle — changing it requires:
# docker compose build frontend && docker compose up -d frontend
NEXT_PUBLIC_BACKEND_URL=https://gateway.local.test/lab/1.0

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_PORT=5433
POSTGRES_USER=wso2
POSTGRES_PASSWORD=wso2123
POSTGRES_DB=wso2db

# ── JVM heap per WSO2 container ─────────────────────────────────────────────
IS_JVM_MEM_OPTS=-Xms1g -Xmx2g
APIM_JVM_MEM_OPTS=-Xms1g -Xmx2g
